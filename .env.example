# Copy to .env for local runs; every pnpm script loads it:  cp .env.example .env && pnpm start
# In GitHub Actions these come from repository Secrets / Variables.

# Summaries (loop 2) always use OpenAI.
OPENAI_API_KEY=

# Loop 1 (relevance, topic, tags, contribution, significance) always uses TypeSafe Jev.
TYPESAFE_API_KEY=

# Optional. Without it the run only writes reports/<date>.md.
TEAMS_WEBHOOK_URL=

# Optional. Author h-index and citation look-ups work without a key on a shared
# rate limit; a key (https://www.semanticscholar.org/product/api) gives a dedicated one.
SEMANTIC_SCHOLAR_API_KEY=

# Optional model overrides (defaults live in finder.config.ts)
# FINDER_JEV_MODEL=
# FINDER_ESCALATE_MODEL=
# FINDER_SUMMARY_MODEL=

# Optional. Base URL used for the "full report" button in the Teams card.
# In GitHub Actions it is derived automatically from the repository.
# REPORT_BASE_URL=https://github.com/<you>/<repo>/blob/main/reports

# Optional. Raises the GitHub API rate limit for code licence look-ups
# (5000 req/h instead of 60). Any github.com token with public read access.
# GITHUB_TOKEN=

# Behind a TLS-inspecting corporate proxy, point Node at the corporate CA.
# Node ignores this one in .env; export it in your shell instead:
#   export NODE_EXTRA_CA_CERTS=/path/to/corp-ca.pem
